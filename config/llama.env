# ------------------------------------------------------------
# Llama runtime tuning  (read by llama.container)
# ------------------------------------------------------------
MODEL=/models/qwen2.5-14b-instruct-q4_k_m-00001-of-00003.gguf
THREADS=10           # will be capped at 10 (already at limit)
CONTEXT_SIZE=8192   # will be capped at 8192 (already at limit)
GPU_LAYERS=70       # safe – caps at 80

# ------------------------------------------------------------
# Service bind address (used by llama.entrypoint.sh)
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8080            # Llama server listens on 8080
