[Container]
ContainerName=gateway
Image=localhost/gateway:b8901
Pod=ai.pod

# ---- Security -------------------------------------------------
User=1000
NoNewPrivileges=true
ReadOnly=false            # needed for /tmp writes

Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=256M

# ---- Runtime configuration ---------------------------------------
EnvironmentFile=%h/.config/containers/env/gateway.env
LogDriver=journald