[Container]
ContainerName=llama
Image=localhost/llama:b8901
Pod=ai.pod

# ---- GPU access -------------------------------------------------
AddDevice=/dev/dri/renderD128

# ---- Security -------------------------------------------------
User=1000
NoNewPrivileges=true

# ---- Filesystem isolation ----------------------------------------
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=256M

# ---- Model storage -----------------------------------------------
Volume=/home/iph/Documents/Repo/llama-podman/models:/models:ro,Z

# ---- Runtime environment -----------------------------------------
EnvironmentFile=%h/.config/llama.env
Environment=GGML_VULKAN_VISIBLE_DEVICES=0
Environment=VK_LOADER_DEBUG=error
Environment=OMP_NUM_THREADS=10
LogDriver=journald