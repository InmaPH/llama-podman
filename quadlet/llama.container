[Container]
ContainerName=llama
Image=localhost/llama:b8901
Pod=ai.pod

# ---- GPU access -------------------------------------------------
AddDevice=/dev/dri/

# ---- Security -------------------------------------------------
User=1000
NoNewPrivileges=true

# ---- Filesystem isolation ----------------------------------------
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=256M

# ---- Model storage -----------------------------------------------
Volume=/home/iph/Documents/Repo/llama-podman/models:/models:ro,Z

# ---- Runtime environment -----------------------------------------
EnvironmentFile=%h/.config/containers/env/llama.env
LogDriver=journald