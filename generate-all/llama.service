# Automatically generated by quadlet
# 
[X-Container]
ContainerName=llama
Image=localhost/llama:b8901
Pod=ai.pod

# ---- GPU access -------------------------------------------------
AddDevice=/dev/dri/renderD128

# ---- Security -------------------------------------------------
User=1000
NoNewPrivileges=true

# ---- Filesystem isolation ----------------------------------------
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=256M

# ---- Model storage -----------------------------------------------
Volume=/home/iph/Documents/Repo/llama-podman/models:/models:ro,Z

# ---- Runtime environment -----------------------------------------
EnvironmentFile=%h/.config/llama.env
Environment=GGML_VULKAN_VISIBLE_DEVICES=0
Environment=VK_LOADER_DEBUG=error
Environment=OMP_NUM_THREADS=10
LogDriver=journald

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
SourcePath=/home/iph/.config/containers/systemd/llama.container
RequiresMountsFor=%t/containers
RequiresMountsFor=/home/iph/Documents/Repo/llama-podman/models
BindsTo=ai-pod.service
After=ai-pod.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i llama
ExecStopPost=-/usr/bin/podman rm -v -f -i llama
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name llama --replace --rm --log-driver journald --cgroups=split --tmpfs /tmp:rw,nosuid,nodev,noexec,size=256M --sdnotify=conmon -d --security-opt=no-new-privileges --device /dev/dri/renderD128 --user 1000 -v /home/iph/Documents/Repo/llama-podman/models:/models:ro,Z --env GGML_VULKAN_VISIBLE_DEVICES=0 --env OMP_NUM_THREADS=10 --env VK_LOADER_DEBUG=error --env-file %h/.config/llama.env --pod ai-pod localhost/llama:b8901
