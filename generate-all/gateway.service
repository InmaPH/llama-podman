# Automatically generated by quadlet
# 
[X-Container]
ContainerName=gateway
Image=localhost/gateway:b8901
Pod=ai.pod

# ---- Security -------------------------------------------------
User=1000
NoNewPrivileges=true
ReadOnly=false            # needed for /tmp writes

Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=256M

# ---- Runtime configuration ---------------------------------------
EnvironmentFile=%h/.config/gateway.env
LogDriver=journald

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
SourcePath=/home/iph/.config/containers/systemd/gateway.container
RequiresMountsFor=%t/containers
BindsTo=ai-pod.service
After=ai-pod.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i gateway
ExecStopPost=-/usr/bin/podman rm -v -f -i gateway
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name gateway --replace --rm --log-driver journald --cgroups=split --tmpfs /tmp:rw,nosuid,nodev,noexec,size=256M --sdnotify=conmon -d --security-opt=no-new-privileges --read-only=false --user 1000 --env-file %h/.config/gateway.env --pod ai-pod localhost/gateway:b8901
